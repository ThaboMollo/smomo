{
  "name": "@smomo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --project-id ltnjiihfgvwtzrmtkclh --schema public > src/database.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@smomo/config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "~5.7.2"
  }
}
