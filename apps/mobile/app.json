{
  "expo": {
    "name": "Smomo",
    "slug": "smomo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smomo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Smomo uses your location to find beauty and body-service providers near you.",
        "NSCameraUsageDescription": "Smomo uses the camera so practitioners can capture proof-of-work photos and everyone can set a profile photo.",
        "NSPhotoLibraryUsageDescription": "Smomo needs photo access to upload portfolio images and profile photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDE9FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_ANDROID_MAPS_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6D28D9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smomo uses your location to find providers near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Smomo needs photo access to upload portfolio and profile photos.",
          "cameraPermission": "Smomo uses the camera for proof-of-work and profile photos."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
