# Production build overrides. Expo loads this only when NODE_ENV=production, which is
# what a release Gradle build sets — so `expo start` keeps using the dev values in `.env`
# (the 10.0.2.2 route to a local API) and only release APKs point at the live service.
#
# Values here are public by definition: EXPO_PUBLIC_* is inlined into the JS bundle and
# is readable by anyone who has the APK. Never put a secret in this file.
EXPO_PUBLIC_API_URL=https://smomo-api.vercel.app/v1
