{
  "name": "smomo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mobile": "pnpm --filter mobile start",
    "web": "pnpm --filter web dev",
    "api": "pnpm --filter api start:dev",
    "gen:types": "pnpm --filter @smomo/shared gen:types"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
